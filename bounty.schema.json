{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/MisterYisme/MisterY-s-Bounties-Hytale-Issue-Report/refs/heads/master/bounty.schema.json",
  "title": "MisterY's Bounties for Hytale Bounty Template",
  "description": "Schema for bounty templates used by the Hytale MisterYs Bounty Mod.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "Id",
    "Type",
    "Objective",
    "Reward"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "The schema to verify this document against.",
      "format": "uri"
    },
    "Id": {
      "type": "string",
      "description": "An unique identifier for the bounty.",
      "pattern": "[a-z]+:[a-z]+"
    },
    "Type": {
      "type": "string",
      "description": "A defining value to correctly process the bounty",
      "enum": [
        "HUNT",
        "ELIMINATE",
        "GATHER",
        "TRAVEL"
      ]
    },
    "Objective": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Group": {
          "type": "string",
          "description": "JSON file containing a list of IDs"
        },
        "Id": {
          "type": "string",
          "description": "A unique ID"
        }
      },
      "oneOf": [
        {
          "required": [
            "Group"
          ],
          "not": {
            "required": [
              "Id"
            ]
          }
        },
        {
          "required": [
            "Id"
          ],
          "not": {
            "required": [
              "Group"
            ]
          }
        }
      ]
    },
    "Reward": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Group": {
          "type": "string",
          "description": "JSON file containing a list of IDs"
        },
        "Id": {
          "type": "string",
          "description": "A unique ID"
        }
      },
      "oneOf": [
        {
          "required": [
            "Group"
          ],
          "not": {
            "required": [
              "Id"
            ]
          }
        },
        {
          "required": [
            "Id"
          ],
          "not": {
            "required": [
              "Group"
            ]
          }
        }
      ]
    }
  }
}