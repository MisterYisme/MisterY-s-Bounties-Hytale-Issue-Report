{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/MisterYisme/MisterY-s-Bounties-Hytale-Issue-Report/refs/heads/master/group.schema.json",
    "title": "MisterY's Bounties for Hytale Group Template",
    "description": "Schema for groups used by the Hytale MisterYs Bounty Mod.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "$schema",
        "Id",
        "Entries"
    ],
    "properties": {
        "$schema": {
            "type": "string"
        },
        "Id": {
            "type": "string",
            "pattern": "[a-z]+:[a-z]+"
        },
        "Entries": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "Id",
                    "Rarity"
                ],
                "properties": {
                    "Id": {
                        "type": "string",
                        "pattern": "^[A-Z][a-z]"
                    },
                    "Rarity": {
                        "type": "string",
                        "enum": [
                            "COMMON",
                            "UNCOMMON",
                            "RARE",
                            "EPIC",
                            "UNIQUE"
                        ]
                    }
                }
            },
            "minItems": 1
        }
    }
}